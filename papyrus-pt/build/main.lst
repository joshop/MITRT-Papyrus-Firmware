 215:Core/Src/main.c **** uint32_t ADC1_ReadInput_mV(uint8_t input)
 216:Core/Src/main.c **** {
 217:Core/Src/main.c ****   uint32_t channel;
 218:Core/Src/main.c **** 
 219:Core/Src/main.c ****   if (input == 2) {
 220:Core/Src/main.c ****     channel = ADC_CHANNEL_2;   // ADC1_IN2
 221:Core/Src/main.c ****   } else if (input == 3) {
 222:Core/Src/main.c ****       channel = ADC_CHANNEL_3;   // ADC1_IN3
 223:Core/Src/main.c ****   } else {
 224:Core/Src/main.c ****         return 0;                  // invalid selection
 225:Core/Src/main.c ****   }
 226:Core/Src/main.c **** 
 227:Core/Src/main.c ****         uint32_t vdda = ADC1_GetVDDA_mV();
 228:Core/Src/main.c ****       uint32_t raw = ADC1_ReadChannel(channel);
 229:Core/Src/main.c **** 
 230:Core/Src/main.c ****     return (raw * vdda) / 4095U;
 231:Core/Src/main.c **** }
 232:Core/Src/main.c **** uint16_t adc_raw[4];
 233:Core/Src/main.c **** uint16_t vref_mV;
 234:Core/Src/main.c **** uint16_t ch2_mV;
 235:Core/Src/main.c **** uint16_t ch3_mV;
 236:Core/Src/main.c **** uint16_t ch4_mV;
 237:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
 238:Core/Src/main.c **** {
 239:Core/Src/main.c ****   if (hadc->Instance == ADC1)
 240:Core/Src/main.c ****   {
 241:Core/Src/main.c ****     uint32_t vref_raw = adc_raw[3];
 242:Core/Src/main.c ****     uint32_t ch2_raw  = adc_raw[0];
 243:Core/Src/main.c ****     uint32_t ch3_raw  = adc_raw[1];
 244:Core/Src/main.c ****     uint32_t ch4_raw  = adc_raw[2];
 245:Core/Src/main.c **** 
 246:Core/Src/main.c ****     uint32_t vrefint_cal = *VREFINT_CAL_ADDR;
 247:Core/Src/main.c **** 
 248:Core/Src/main.c ****     // Compute actual VDD in mV
 249:Core/Src/main.c ****     vref_mV = (VREFINT_CAL_VREF * vrefint_cal) / vref_raw;
 250:Core/Src/main.c **** 
 251:Core/Src/main.c ****     // Convert channels to mV
 252:Core/Src/main.c ****     ch2_mV = (ch2_raw * vref_mV) / 4095;
 253:Core/Src/main.c ****     ch3_mV = (ch3_raw * vref_mV) / 4095;
 254:Core/Src/main.c ****     ch4_mV = (ch4_raw * vref_mV) / 4095;
 255:Core/Src/main.c ****   }
 256:Core/Src/main.c **** }
