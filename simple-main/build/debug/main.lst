 612:Core/Src/main.c ****   word[wlen] = 0;
 613:Core/Src/main.c ****   if ((*buf)[wlen]) wlen++;
 614:Core/Src/main.c ****   *buf += wlen;
 615:Core/Src/main.c **** }
