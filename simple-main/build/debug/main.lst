 639:Core/Src/main.c ****     "  sd free: print microSD free space\r\n"
 640:Core/Src/main.c ****     "  sd deinit: deinitalize microSD\r\n"
 641:Core/Src/main.c ****     "file - file operations\r\n"
 642:Core/Src/main.c ****     "  file run <file>: runs a file as commands\r\n"
 643:Core/Src/main.c ****     "  file program <file>: programs a file. Typed commands are written to the end of the file\r\n"
 644:Core/Src/main.c ****     "  file endp: stop programming and write commands to file\r\n"
 645:Core/Src/main.c ****     "  file read <file>: reads all lines in a file\r\n"
 646:Core/Src/main.c ****     "  file delete <file>: deletes a file\r\n"
 647:Core/Src/main.c ****     "  file delline <file> <line>: deletes a single line of a file\r\n"
 648:Core/Src/main.c ****     "  file list: lists files in root directory\r\n"
 649:Core/Src/main.c ****     "relay - control relays\r\n"
 650:Core/Src/main.c ****     "  relay off <device>: turns off a relay, supports entire boards\r\n"
 651:Core/Src/main.c ****     "  relay on <device>: turns on a relay\r\n"
 652:Core/Src/main.c ****     "  relay reset <device>: reset relay boards\r\n"
 653:Core/Src/main.c ****     "servo - control servos\r\n"
 654:Core/Src/main.c ****     "  servo off <device>: disengage servo\r\n"
 655:Core/Src/main.c ****     "  servo on <device>: engage servo\r\n"
 656:Core/Src/main.c ****     "  servo set <device> <angle>: set servo to angle\r\n"
 657:Core/Src/main.c ****     "  servo reset <device>: reset servo boards\r\n"
 658:Core/Src/main.c ****     "tc - control thermocouples\r\n"
 659:Core/Src/main.c ****     "  tc get <device>: reads TC temperature\r\n"
 660:Core/Src/main.c ****     "  tc status <device>: reads TC status flags\r\n"
 661:Core/Src/main.c ****     "  tc reset <device>: resets TC boards\r\n"
 662:Core/Src/main.c ****     "pt - control pressure transducers\r\n"
 663:Core/Src/main.c ****     "  pt get <device>: reads PT pressure\r\n"
 664:Core/Src/main.c ****     "  pt reset <device>: resets PT boards\r\n"
