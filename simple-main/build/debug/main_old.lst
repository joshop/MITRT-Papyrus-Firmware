  84:Core/Src/main_old.c **** void Process_UART_Command(char *cmd)
  85:Core/Src/main_old.c **** {
  86:Core/Src/main_old.c ****   if (cmd[0] == '1') {
  87:Core/Src/main_old.c ****     can_target = 0x123;
  88:Core/Src/main_old.c ****   } else if (cmd[0] == '2') {
  89:Core/Src/main_old.c ****     can_target = 0x124;
  90:Core/Src/main_old.c ****   } else {
ARM GAS  C:\Users\sante\AppData\Local\Temp\ccJXjfq5.s 			page 3


  91:Core/Src/main_old.c ****     UART2_Print("Invalid target\r\n");
  92:Core/Src/main_old.c ****     return;
  93:Core/Src/main_old.c ****   }
  94:Core/Src/main_old.c ****   cmd += 2;
  95:Core/Src/main_old.c ****   if (!strcmp(cmd, "r1 on"))       CAN_Send(0x01);
  96:Core/Src/main_old.c ****   else if (!strcmp(cmd, "r1 off")) CAN_Send(0x02);
  97:Core/Src/main_old.c ****   else if (!strcmp(cmd, "r2 on"))  CAN_Send(0x03);
  98:Core/Src/main_old.c ****   else if (!strcmp(cmd, "r2 off")) CAN_Send(0x04);
  99:Core/Src/main_old.c ****   else if (!strcmp(cmd, "r3 on"))  CAN_Send(0x05);
 100:Core/Src/main_old.c ****   else if (!strcmp(cmd, "r3 off")) CAN_Send(0x06);
 101:Core/Src/main_old.c ****   else if (!strcmp(cmd, "get r1")) CAN_Send(0x10);
 102:Core/Src/main_old.c ****   else if (!strcmp(cmd, "get r2")) CAN_Send(0x11);
 103:Core/Src/main_old.c ****   else if (!strcmp(cmd, "get r3")) CAN_Send(0x12);
 104:Core/Src/main_old.c ****   else if (!strcmp(cmd, "get all"))CAN_Send(0x13);
 105:Core/Src/main_old.c ****   else if (!strcmp(cmd, "reset"))  CAN_Send(0xFF);
 106:Core/Src/main_old.c ****   else UART2_Print("Unknown command\r\n");
 107:Core/Src/main_old.c **** }
 108:Core/Src/main_old.c **** void CAN_Send(uint8_t cmd)
 109:Core/Src/main_old.c **** {
 110:Core/Src/main_old.c ****   FDCAN_TxHeaderTypeDef txHeader = {0};
 111:Core/Src/main_old.c ****   FDCAN_RxHeaderTypeDef rxHeader;
 112:Core/Src/main_old.c ****   uint8_t txData[8] = {cmd};
 113:Core/Src/main_old.c ****   uint8_t rxData[8];
 114:Core/Src/main_old.c **** 
 115:Core/Src/main_old.c ****   txHeader.Identifier = can_target;
 116:Core/Src/main_old.c ****   txHeader.IdType = FDCAN_STANDARD_ID;
 117:Core/Src/main_old.c ****   txHeader.TxFrameType = FDCAN_DATA_FRAME;
 118:Core/Src/main_old.c ****   txHeader.DataLength = FDCAN_DLC_BYTES_1;
 119:Core/Src/main_old.c ****   txHeader.FDFormat = FDCAN_CLASSIC_CAN;
 120:Core/Src/main_old.c ****   txHeader.BitRateSwitch = FDCAN_BRS_OFF;
 121:Core/Src/main_old.c **** 
 122:Core/Src/main_old.c ****   HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &txHeader, txData);
 123:Core/Src/main_old.c **** 
 124:Core/Src/main_old.c ****   /* Wait for response */
 125:Core/Src/main_old.c **** 
 126:Core/Src/main_old.c ****   uint32_t tick = HAL_GetTick();
 127:Core/Src/main_old.c **** 
 128:Core/Src/main_old.c ****   while (HAL_FDCAN_GetRxFifoFillLevel(&hfdcan1, FDCAN_RX_FIFO0) == 0 && HAL_GetTick() - tick < 500)
 129:Core/Src/main_old.c **** 
 130:Core/Src/main_old.c ****   if (HAL_FDCAN_GetRxFifoFillLevel(&hfdcan1, FDCAN_RX_FIFO0) == 0) {
 131:Core/Src/main_old.c ****     UART2_Print("(NO ACK)\r\n");
 132:Core/Src/main_old.c ****     return;
 133:Core/Src/main_old.c ****   }
 134:Core/Src/main_old.c **** 
 135:Core/Src/main_old.c ****   HAL_FDCAN_GetRxMessage(&hfdcan1, FDCAN_RX_FIFO0, &rxHeader, rxData);
 136:Core/Src/main_old.c **** 
 137:Core/Src/main_old.c ****   uint16_t resp_id = rxHeader.Identifier;
 138:Core/Src/main_old.c **** 
 139:Core/Src/main_old.c ****   /* Decode response */
 140:Core/Src/main_old.c ****   char out[64];
 141:Core/Src/main_old.c **** 
 142:Core/Src/main_old.c ****   if (cmd >= 0x10 && cmd <= 0x12)
 143:Core/Src/main_old.c ****   {
 144:Core/Src/main_old.c ****     sprintf(out, "(%x) R%d=%d\r\n", resp_id, cmd - 0x0F, rxData[1]);
 145:Core/Src/main_old.c ****   }
 146:Core/Src/main_old.c ****   else if (cmd == 0x13)
 147:Core/Src/main_old.c ****   {
ARM GAS  C:\Users\sante\AppData\Local\Temp\ccJXjfq5.s 			page 4


 148:Core/Src/main_old.c ****     sprintf(out, "(%x) R1=%d R2=%d R3=%d\r\n", resp_id,
 149:Core/Src/main_old.c ****             rxData[1], rxData[2], rxData[3]);
 150:Core/Src/main_old.c ****   }
 151:Core/Src/main_old.c ****   else
 152:Core/Src/main_old.c ****   {
 153:Core/Src/main_old.c ****     sprintf(out, "(%x) OK\r\n", resp_id);
 154:Core/Src/main_old.c ****   }
 155:Core/Src/main_old.c **** 
 156:Core/Src/main_old.c ****   UART2_Print(out);
 157:Core/Src/main_old.c **** }
