1066:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_uart.c ****         (+) HAL_UART_AbortTransmit()
1067:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_uart.c ****         (+) HAL_UART_AbortReceive()
