 593:Core/Src/main.c ****         }
 594:Core/Src/main.c ****         UART2_Print(")");
 595:Core/Src/main.c ****       }
 596:Core/Src/main.c ****     }
 597:Core/Src/main.c ****     UART2_Print(" - ");
