 500:Core/Src/main.c ****     char name[15];
 501:Core/Src/main.c ****     uint8_t index;
 502:Core/Src/main.c ****   } names[8];
 503:Core/Src/main.c ****   union {
 504:Core/Src/main.c ****     ServoCfg servo;
