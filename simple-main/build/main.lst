 126:Core/Src/main.c **** uint32_t ADC_Get_VDDA_mV(void)
 127:Core/Src/main.c **** {
 128:Core/Src/main.c ****   uint16_t vrefint_raw = ADC_Read_VREFINT();
 129:Core/Src/main.c ****   uint16_t vrefint_cal = *VREFINT_CAL_ADDR;
 130:Core/Src/main.c **** 
 131:Core/Src/main.c ****   // VDDA = 3.0V * VREFINT_CAL / VREFINT_DATA
 132:Core/Src/main.c ****   // 3000 mV is the calibration reference voltage
ARM GAS  /tmp/ccyus1KS.s 			page 39


 133:Core/Src/main.c ****   uint32_t vdda = 3000UL * vrefint_cal / vrefint_raw;
