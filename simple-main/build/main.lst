 138:Core/Src/main.c **** void CAN_Rx_TC(FDCAN_RxHeaderTypeDef rxHeader) {
 139:Core/Src/main.c ****   char buff[64];
 140:Core/Src/main.c ****   int16_t tc_t = *(int16_t*)(lastRxData+1);
 141:Core/Src/main.c ****   float tc_tf = ((float)tc_t) / 4.0;
 142:Core/Src/main.c ****   if (lastRxData[1] == 0xFF && lastRxData[2] == 0xFF) {
 143:Core/Src/main.c ****     sprintf(buff, "TC Fault\r\n");
 144:Core/Src/main.c ****   } else {
 145:Core/Src/main.c ****     sprintf(buff, "T = %.2f C\r\n", tc_tf);
 146:Core/Src/main.c ****   }
 147:Core/Src/main.c ****   UART2_Print(buff);
 148:Core/Src/main.c **** }
 149:Core/Src/main.c **** void CAN_Rx_PT(FDCAN_RxHeaderTypeDef rxHeader) {
