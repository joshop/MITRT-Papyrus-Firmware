 954:Core/Src/main.c ****     fres = f_readdir(&dir, &filinfo);
 955:Core/Src/main.c ****     if (fres != FR_OK || filinfo.fname[0] == 0) break;
 956:Core/Src/main.c ****     unsigned long size = filinfo.fsize;
 957:Core/Src/main.c ****     const char *prefix;
 958:Core/Src/main.c ****     if (size > 10*1073741824) {
 959:Core/Src/main.c ****       prefix = "GiB";
 960:Core/Src/main.c ****       size >>= 30;
 961:Core/Src/main.c ****     } else if (size > 10*1048576) {
 962:Core/Src/main.c ****       prefix = "MiB";
 963:Core/Src/main.c ****       size >>= 20;
 964:Core/Src/main.c ****     } else if (size > 10*1024) {
 965:Core/Src/main.c ****       prefix = "KiB";
 966:Core/Src/main.c ****       size >>= 10;
 967:Core/Src/main.c ****     } else {
 968:Core/Src/main.c ****       prefix = "B";
 969:Core/Src/main.c ****     }
 970:Core/Src/main.c ****     sprintf(buffer, "%-18s %lu %s\r\n", filinfo.fname, size, prefix);
 971:Core/Src/main.c ****     UART2_Print(buffer);
 972:Core/Src/main.c ****   }
 973:Core/Src/main.c ****   f_closedir(&dir);
 974:Core/Src/main.c **** }
