 100:Core/Src/main.c **** uint16_t ADC_Read_VREFINT(void)
 101:Core/Src/main.c **** {
 102:Core/Src/main.c ****   ADC_ChannelConfTypeDef sConfig = {0};
 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****   sConfig.Channel = ADC_CHANNEL_VREFINT;
 105:Core/Src/main.c ****   sConfig.Rank = ADC_REGULAR_RANK_1;
 106:Core/Src/main.c ****   sConfig.SamplingTime = ADC_SAMPLINGTIME_COMMON_1;
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****   HAL_ADC_ConfigChannel(&hadc1, &sConfig);
 109:Core/Src/main.c **** 
 110:Core/Src/main.c ****   HAL_ADC_Start(&hadc1);
 111:Core/Src/main.c ****   HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
 112:Core/Src/main.c ****   HAL_ADC_GetValue(&hadc1);
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****   HAL_ADC_Start(&hadc1);
 115:Core/Src/main.c ****   HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
 116:Core/Src/main.c ****   uint16_t raw = HAL_ADC_GetValue(&hadc1);
 117:Core/Src/main.c ****   HAL_ADC_Stop(&hadc1);
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****   return raw;
 120:Core/Src/main.c **** }
 121:Core/Src/main.c **** uint32_t ADC_Get_VDDA_mV(void)
 122:Core/Src/main.c **** {
 123:Core/Src/main.c ****   uint16_t vrefint_raw = ADC_Read_VREFINT();
 124:Core/Src/main.c ****   uint16_t vrefint_cal = *VREFINT_CAL_ADDR;
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****   // VDDA = 3.0V * VREFINT_CAL / VREFINT_DATA
 127:Core/Src/main.c ****   // 3000 mV is the calibration reference voltage
 128:Core/Src/main.c ****   uint32_t vdda = 3000UL * vrefint_cal / vrefint_raw;
 129:Core/Src/main.c **** 
 130:Core/Src/main.c ****   return vdda;
 131:Core/Src/main.c **** }
