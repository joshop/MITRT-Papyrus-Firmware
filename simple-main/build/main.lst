 305:Core/Src/main.c ****         m = &name_maps[i];
 306:Core/Src/main.c ****       break;
 307:Core/Src/main.c ****     }
 308:Core/Src/main.c ****   }
 309:Core/Src/main.c ****   if (num_maps == 32) return 1;
 310:Core/Src/main.c ****   if (m == NULL) {
 311:Core/Src/main.c ****     m = &name_maps[num_maps];
 312:Core/Src/main.c ****     num_maps++;
 313:Core/Src/main.c ****   }
 314:Core/Src/main.c **** 
 315:Core/Src/main.c ****   for (int i = 0; i < m->num_names; i++) {
 316:Core/Src/main.c ****     if (!strcmp(m->names[i].name, name)) return 2;
 317:Core/Src/main.c ****   }
 318:Core/Src/main.c ****   if (m->num_names == 8) return 3;
 319:Core/Src/main.c ****   if (strlen(name) > 14) return 4;
 320:Core/Src/main.c ****   strcpy(m->names[m->num_names].name, name);
 321:Core/Src/main.c ****   m->names[m->num_names].index = index;
 322:Core/Src/main.c ****   m->num_names++;
 323:Core/Src/main.c ****   m->can_id = can_id;
 324:Core/Src/main.c ****   memset(&(m->cfg), 0, sizeof(m->cfg));
 325:Core/Src/main.c ****   return 0;
 326:Core/Src/main.c **** }
