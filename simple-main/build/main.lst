 609:Core/Src/main.c **** void next_word(char *word, char **buf) {
 610:Core/Src/main.c ****   int wlen = strcspn(*buf, " ");
 611:Core/Src/main.c ****   memcpy(word, *buf, wlen);
 612:Core/Src/main.c ****   word[wlen] = 0;
 613:Core/Src/main.c ****   if ((*buf)[wlen]) wlen++;
 614:Core/Src/main.c ****   *buf += wlen;
 615:Core/Src/main.c **** }
 616:Core/Src/main.c **** 
 617:Core/Src/main.c **** int all_numeric(char *s) {
 618:Core/Src/main.c ****   if (!*s) return 0;
 619:Core/Src/main.c ****   for (int i = 0; i < strlen(s); i++) {
 620:Core/Src/main.c ****     if (s[i] > '9' || s[i] < '0') return 0;
 621:Core/Src/main.c ****   }
 622:Core/Src/main.c ****   return 1;
 623:Core/Src/main.c **** }
