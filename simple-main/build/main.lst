 377:Core/Src/main.c **** int32_t HX711_ReadRaw(HX711_HandleTypeDef *hx)
 378:Core/Src/main.c **** {
ARM GAS  /tmp/ccC6cUpb.s 			page 44


 379:Core/Src/main.c ****   int32_t data = 0;
 380:Core/Src/main.c **** 
 381:Core/Src/main.c ****   // Wait for DOUT to go low (data ready)
 382:Core/Src/main.c ****   while (HAL_GPIO_ReadPin(hx->dout_port, hx->dout_pin) == GPIO_PIN_SET);
 383:Core/Src/main.c **** 
 384:Core/Src/main.c ****   for (int i = 0; i < 24; i++)
 385:Core/Src/main.c ****   {
 386:Core/Src/main.c ****     HAL_GPIO_WritePin(hx->sck_port, hx->sck_pin, GPIO_PIN_SET);
 387:Core/Src/main.c ****     HX711_Delay();
 388:Core/Src/main.c **** 
 389:Core/Src/main.c ****     data = data << 1;
 390:Core/Src/main.c ****     HAL_GPIO_WritePin(hx->sck_port, hx->sck_pin, GPIO_PIN_RESET);
 391:Core/Src/main.c ****     HX711_Delay();
 392:Core/Src/main.c **** 
 393:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(hx->dout_port, hx->dout_pin))
 394:Core/Src/main.c ****       data++;
 395:Core/Src/main.c ****   }
 396:Core/Src/main.c **** 
 397:Core/Src/main.c ****   // 25th pulse → Channel A, Gain 128
 398:Core/Src/main.c ****   HAL_GPIO_WritePin(hx->sck_port, hx->sck_pin, GPIO_PIN_SET);
 399:Core/Src/main.c ****   HX711_Delay();
 400:Core/Src/main.c ****   HAL_GPIO_WritePin(hx->sck_port, hx->sck_pin, GPIO_PIN_RESET);
 401:Core/Src/main.c ****   HX711_Delay();
 402:Core/Src/main.c **** 
 403:Core/Src/main.c ****   // Sign extend 24-bit value
 404:Core/Src/main.c ****   if (data & 0x800000)
 405:Core/Src/main.c ****     data |= 0xFF000000;
 406:Core/Src/main.c ****   char buf[64];
 407:Core/Src/main.c ****   return data;
 408:Core/Src/main.c **** }
