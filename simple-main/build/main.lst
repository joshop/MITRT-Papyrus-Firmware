 780:Core/Src/main.c **** void command_relay(char *rest) {
 781:Core/Src/main.c ****   /* Relay fmt:
 782:Core/Src/main.c ****    * 1: R1 ON
 783:Core/Src/main.c ****    * 2: R1 OFF
 784:Core/Src/main.c ****    * 3: R2 ON
 785:Core/Src/main.c ****    * 4: R2 OFF
 786:Core/Src/main.c ****    * 5: R3 ON
 787:Core/Src/main.c ****    * 6: R3 OFF
 788:Core/Src/main.c ****    * 16: Get R1
 789:Core/Src/main.c ****    * 17: Get R2
 790:Core/Src/main.c ****    * 18: Get R3
 791:Core/Src/main.c ****    */
 792:Core/Src/main.c ****   char word[32];
 793:Core/Src/main.c ****   next_word(word, &rest);
 794:Core/Src/main.c ****   if (!strcmp(word, "off")) {
 795:Core/Src/main.c ****     int id = retrieve_id(rest);
 796:Core/Src/main.c ****     if (id == 0) {
 797:Core/Src/main.c ****       UART2_Print(terse ? "Invalid\r\n" : "Invalid ID or device name.\r\n");
 798:Core/Src/main.c ****       return;
 799:Core/Src/main.c ****     }
 800:Core/Src/main.c ****     next_can_id = id;
 801:Core/Src/main.c ****     int cmd;
 802:Core/Src/main.c ****     if (!terse) {
 803:Core/Src/main.c ****       UART2_Print(rest);
 804:Core/Src/main.c ****       UART2_Print(": ");
 805:Core/Src/main.c ****     }
 806:Core/Src/main.c **** 
 807:Core/Src/main.c ****     just_set_solenoid = 1;
 808:Core/Src/main.c ****     just_set_id = next_can_id;
 809:Core/Src/main.c ****     just_set_val = 0;
 810:Core/Src/main.c ****     just_set_idx = last_index;
 811:Core/Src/main.c ****     if (last_index == 1) {
