 618:Core/Src/main.c **** void command_help(char *rest) {
 619:Core/Src/main.c ****   cmd_invalid = 1;
 620:Core/Src/main.c ****   UART2_Print("List of commands:\r\n"
 621:Core/Src/main.c ****     "!reset: reset STM32 remotely\r\n"
 622:Core/Src/main.c ****     "name - name CAN devices\r\n"
 623:Core/Src/main.c ****     "  name <can id> <name> [<index>]: name a device\r\n"
 624:Core/Src/main.c ****     "  name clear <can id>: clear names\r\n"
 625:Core/Src/main.c ****     "  name list <can id>: list names\r\n"
 626:Core/Src/main.c ****     "bus - CAN bus operations\r\n"
 627:Core/Src/main.c ****     "  bus reset: reset whole CAN bus\r\n"
 628:Core/Src/main.c ****     "  bus list: list all devices on bus\r\n"
 629:Core/Src/main.c ****     "sd - SD card setup\r\n"
 630:Core/Src/main.c ****     "  sd init: initialize microSD\r\n"
 631:Core/Src/main.c ****     "  sd free: print microSD free space\r\n"
 632:Core/Src/main.c ****     "  sd deinit: deinitalize microSD\r\n"
 633:Core/Src/main.c ****     "file - file operations\r\n"
 634:Core/Src/main.c ****     "  file run <file>: runs a file as commands\r\n"
 635:Core/Src/main.c ****     "  file program <file>: programs a file. Typed commands are written to the end of the file\r\n"
 636:Core/Src/main.c ****     "  file endp: stop programming and write commands to file\r\n"
 637:Core/Src/main.c ****     "  file read <file>: reads all lines in a file\r\n"
 638:Core/Src/main.c ****     "  file delete <file>: deletes a file\r\n"
 639:Core/Src/main.c ****     "  file delline <file> <line>: deletes a single line of a file\r\n"
 640:Core/Src/main.c ****     "  file list: lists files in root directory\r\n"
 641:Core/Src/main.c ****     "relay - control relays\r\n"
 642:Core/Src/main.c ****     "  relay off <device>: turns off a relay, supports entire boards\r\n"
 643:Core/Src/main.c ****     "  relay on <device>: turns on a relay\r\n"
 644:Core/Src/main.c ****     "  relay reset <device>: reset relay boards\r\n"
 645:Core/Src/main.c ****     "servo - control servos\r\n"
 646:Core/Src/main.c ****     "  servo off <device>: disengage servo\r\n"
 647:Core/Src/main.c ****     "  servo on <device>: engage servo\r\n"
 648:Core/Src/main.c ****     "  servo set <device> <angle>: set servo to angle\r\n"
 649:Core/Src/main.c ****     "  servo reset <device>: reset servo boards\r\n"
 650:Core/Src/main.c ****     "tc - control thermocouples\r\n"
 651:Core/Src/main.c ****     "  tc get <device>: reads TC temperature\r\n"
 652:Core/Src/main.c ****     "  tc status <device>: reads TC status flags\r\n"
 653:Core/Src/main.c ****     "  tc reset <device>: resets TC boards\r\n"
 654:Core/Src/main.c ****     "pt - control pressure transducers\r\n"
 655:Core/Src/main.c ****     "  pt get <device>: reads PT pressure\r\n"
 656:Core/Src/main.c ****     "  pt reset <device>: resets PT boards\r\n"
 657:Core/Src/main.c ****     "time - timer functions\r\n"
 658:Core/Src/main.c ****     "  time stamp: get current timestamp\r\n"
 659:Core/Src/main.c ****     "  time mark: set mark, time stamp shows time since mark\r\n"
 660:Core/Src/main.c ****     "  time sleep <ms>: sleep for a time in ms\r\n"
 661:Core/Src/main.c ****     "  time delay <ms> <command...>: run the command after a time in ms\r\n"
 662:Core/Src/main.c ****     "  time every <ms> <command...>: run the command every interval in ms\r\n"
 663:Core/Src/main.c ****     "  time list: list timers running\r\n"
ARM GAS  /tmp/cckhaOq6.s 			page 49


 664:Core/Src/main.c ****     "  time delete [<id>]: delete that timer, default is last added\r\n"
 665:Core/Src/main.c ****     "  time quiet [<id>]: silence/unsilence messages from that timer\r\n"
 666:Core/Src/main.c ****     "msg - message functions\r\n"
 667:Core/Src/main.c ****     "  msg echo <message...>: prints the message out\r\n"
 668:Core/Src/main.c ****     "log - data logging functions\r\n"
 669:Core/Src/main.c ****     "  log open <file>: opens file for data logging, append to end\r\n"
 670:Core/Src/main.c ****     "  log close: close open log file\r\n"
 671:Core/Src/main.c ****     "  log sync: write new changes back to log file\r\n"
 672:Core/Src/main.c ****     "  log line <format...>: write a line of data to the log file; specifiers separated by spaces:\
 673:Core/Src/main.c ****     "   t -> time stamp in ms\r\n"
 674:Core/Src/main.c ****     "   m -> time since mark in ms\r\n"
 675:Core/Src/main.c ****     "   '<TEXT> -> that text\r\n"
 676:Core/Src/main.c ****     "   P<PT name> -> pressure in psi\r\n"
 677:Core/Src/main.c ****     "On startup or reset, startup.scr is run automatically.\r\n"
 678:Core/Src/main.c ****   );
 679:Core/Src/main.c **** }
 680:Core/Src/main.c **** void command_bus(char *rest) {
 681:Core/Src/main.c ****   char word[32];
 682:Core/Src/main.c ****   next_word(word, &rest);
 683:Core/Src/main.c ****   if (!strcmp(word, "reset")) {
 684:Core/Src/main.c ****     UART2_Print("Full bus reset...\r\n");
 685:Core/Src/main.c ****     NVIC_SystemReset();
 686:Core/Src/main.c ****   } else if (!strcmp(word, "list")) {
 687:Core/Src/main.c ****     bus_list_function();
 688:Core/Src/main.c ****   } else if (!strcmp(word, "vdd")) {
 689:Core/Src/main.c ****     char buffer[256];
 690:Core/Src/main.c ****     sprintf(buffer, terse ? "%dm\r\n" : "VDD = %d mV\r\n", vref_mV);
 691:Core/Src/main.c ****     UART2_Print(buffer);
 692:Core/Src/main.c ****   } else if (!*word) {
 693:Core/Src/main.c ****     cmd_invalid = 1;
 694:Core/Src/main.c ****     UART2_Print(terse ? "Invalid\r\n" : "Option needed for \"bus\".\r\n");
 695:Core/Src/main.c ****   } else {
 696:Core/Src/main.c ****     cmd_invalid = 1;
 697:Core/Src/main.c ****     UART2_Print(terse ? "Invalid" : "Unknown option for \"bus\": ");
 698:Core/Src/main.c ****     if (!terse) UART2_Print(word);
 699:Core/Src/main.c ****     UART2_Print("\r\n");
 700:Core/Src/main.c ****   }
 701:Core/Src/main.c **** }
