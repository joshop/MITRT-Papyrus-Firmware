 513:Core/Src/main.c ****   if (m == NULL) {
 514:Core/Src/main.c ****     m = &name_maps[num_maps];
 515:Core/Src/main.c ****     num_maps++;
 516:Core/Src/main.c ****   }
 517:Core/Src/main.c **** 
 518:Core/Src/main.c ****   for (int i = 0; i < m->num_names; i++) {
 519:Core/Src/main.c ****     if (!strcmp(m->names[i].name, name)) return 2;
 520:Core/Src/main.c ****   }
 521:Core/Src/main.c ****   if (m->num_names == 8) return 3;
 522:Core/Src/main.c ****   if (strlen(name) > 14) return 4;
 523:Core/Src/main.c ****   strcpy(m->names[m->num_names].name, name);
 524:Core/Src/main.c ****   m->names[m->num_names].index = index;
 525:Core/Src/main.c ****   m->num_names++;
 526:Core/Src/main.c ****   m->can_id = can_id;
 527:Core/Src/main.c ****   memset(&(m->cfg), 0, sizeof(m->cfg));
 528:Core/Src/main.c ****   return 0;
 529:Core/Src/main.c **** }
