 316:Core/Src/main.c ****   if (HAL_FDCAN_GetRxFifoFillLevel(&hfdcan1, FDCAN_RX_FIFO0) == 0) {
 317:Core/Src/main.c ****     UART2_Print("(NO ACK)\r\n");
 318:Core/Src/main.c ****     just_set_solenoid = 0;
 319:Core/Src/main.c ****     return;
 320:Core/Src/main.c ****   }
 321:Core/Src/main.c **** 
 322:Core/Src/main.c ****   HAL_FDCAN_GetRxMessage(&hfdcan1, FDCAN_RX_FIFO0, &rxHeader, lastRxData);
 323:Core/Src/main.c **** 
 324:Core/Src/main.c ****   CAN_Rx_Func(rxHeader);
 325:Core/Src/main.c ****   CAN_Rx_Func = CAN_Rx_Default;
 326:Core/Src/main.c **** 
 327:Core/Src/main.c **** }
