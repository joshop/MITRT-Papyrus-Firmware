 908:Core/Src/main.c **** uint16_t servo_get_us(char *label, uint16_t angle) {
 909:Core/Src/main.c ****   ServoCfg *servo = NULL;
 910:Core/Src/main.c ****   ServoCfg def = {0};
 911:Core/Src/main.c ****   for (int i = 0; i < num_maps; i++) {
 912:Core/Src/main.c ****     if (name_maps[i].can_id == atoi(label)) {
 913:Core/Src/main.c ****       servo = &name_maps[i].cfg.servo;
 914:Core/Src/main.c ****       break;
 915:Core/Src/main.c ****     }
 916:Core/Src/main.c ****     for (int j = 0; j < name_maps[i].num_names; j++) {
 917:Core/Src/main.c ****       if (!strcmp(name_maps[i].names[j].name, label)) {
 918:Core/Src/main.c ****         servo = &name_maps[i].cfg.servo;
 919:Core/Src/main.c ****         break;
 920:Core/Src/main.c ****       }
 921:Core/Src/main.c ****     }
 922:Core/Src/main.c ****   }
