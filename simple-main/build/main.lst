 162:Core/Src/main.c **** void update_solenoid() {
 163:Core/Src/main.c ****   UART2_Print("Updating flash record: ");
 164:Core/Src/main.c ****   for (int i = 0; i < 18; i++) {
 165:Core/Src/main.c ****     UART2_Print_Int(emergency_solenoid[i]);
 166:Core/Src/main.c ****     UART2_Print(i == 17 ? "\r\n" : ",");
 167:Core/Src/main.c ****   }
