 209:Core/Src/main.c **** uint32_t ADC_Get_VDDA_mV(void)
 210:Core/Src/main.c **** {
 211:Core/Src/main.c ****   uint16_t vrefint_raw = ADC_Read_VREFINT();
 212:Core/Src/main.c ****   uint16_t vrefint_cal = *VREFINT_CAL_ADDR;
 213:Core/Src/main.c **** 
 214:Core/Src/main.c ****   // VDDA = 3.0V * VREFINT_CAL / VREFINT_DATA
 215:Core/Src/main.c ****   // 3000 mV is the calibration reference voltage
 216:Core/Src/main.c ****   uint32_t vdda = 3000UL * vrefint_cal / vrefint_raw;
 217:Core/Src/main.c **** 
 218:Core/Src/main.c ****   return vdda;
 219:Core/Src/main.c **** }
