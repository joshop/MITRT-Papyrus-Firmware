 169:Core/Src/main.c **** }
 170:Core/Src/main.c **** void restore_solenoid() {
 171:Core/Src/main.c ****   Flash_LoadArray(FLASH_USER_PAGE_ADDR, emergency_solenoid, 18);
 172:Core/Src/main.c ****   if (!need_restore) return;
 173:Core/Src/main.c ****   emergency_solenoid[5] = 0;
 174:Core/Src/main.c ****   for (int i = 0; i < 18; i++) {
 175:Core/Src/main.c ****     next_can_id = 105 + i / 3;
 176:Core/Src/main.c ****     UART2_Print("Restoring ");
 177:Core/Src/main.c ****     UART2_Print_Int(next_can_id);
 178:Core/Src/main.c ****     UART2_Print(":");
 179:Core/Src/main.c ****     UART2_Print_Int(i % 3 + 1);
 180:Core/Src/main.c ****     UART2_Print("=");
 181:Core/Src/main.c ****     int command = 1 + (i % 3) * 2 + (emergency_solenoid[i] ? 1 : 0);
 182:Core/Src/main.c ****     UART2_Print_Int(command);
 183:Core/Src/main.c ****     UART2_Print("\r\n");
 184:Core/Src/main.c ****     CAN_Send(command);
 185:Core/Src/main.c ****     HAL_Delay(250);
 186:Core/Src/main.c ****   }
 187:Core/Src/main.c **** }
