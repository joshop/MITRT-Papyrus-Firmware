 949:Core/Src/main.c ****     UART2_Print("Unable to open directory.\r\n");
 950:Core/Src/main.c ****     return;
 951:Core/Src/main.c ****   }
 952:Core/Src/main.c ****   UART2_Print("Files on SD card:\r\n");
