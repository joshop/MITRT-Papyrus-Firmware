 512:Core/Src/main.c **** int add_namemap(int can_id, char *name, uint8_t index) {
 513:Core/Src/main.c ****   NameMap *m = NULL;
 514:Core/Src/main.c ****   for (int i = 0; i < num_maps; i++) {
 515:Core/Src/main.c ****     if (name_maps[i].can_id == can_id) {
 516:Core/Src/main.c ****         m = &name_maps[i];
 517:Core/Src/main.c ****       break;
 518:Core/Src/main.c ****     }
 519:Core/Src/main.c ****   }
 520:Core/Src/main.c ****   if (num_maps == 32) return 1;
 521:Core/Src/main.c ****   if (m == NULL) {
 522:Core/Src/main.c ****     m = &name_maps[num_maps];
 523:Core/Src/main.c ****     num_maps++;
 524:Core/Src/main.c ****   }
 525:Core/Src/main.c **** 
 526:Core/Src/main.c ****   for (int i = 0; i < m->num_names; i++) {
 527:Core/Src/main.c ****     if (!strcmp(m->names[i].name, name)) return 2;
 528:Core/Src/main.c ****   }
 529:Core/Src/main.c ****   if (m->num_names == 8) return 3;
 530:Core/Src/main.c ****   if (strlen(name) > 14) return 4;
 531:Core/Src/main.c ****   strcpy(m->names[m->num_names].name, name);
 532:Core/Src/main.c ****   m->names[m->num_names].index = index;
 533:Core/Src/main.c ****   m->num_names++;
 534:Core/Src/main.c ****   m->can_id = can_id;
 535:Core/Src/main.c ****   memset(&(m->cfg), 0, sizeof(m->cfg));
 536:Core/Src/main.c ****   return 0;
 537:Core/Src/main.c **** }
 538:Core/Src/main.c **** 
