 393:Core/Src/main.c **** int cmd_invalid = 0;
 394:Core/Src/main.c **** void command_help(char *rest) {
 395:Core/Src/main.c ****   cmd_invalid = 1;
 396:Core/Src/main.c ****   UART2_Print("List of commands:\r\n"
 397:Core/Src/main.c ****     "!reset: reset STM32 remotely\r\n"
 398:Core/Src/main.c ****     "name - name CAN devices\r\n"
 399:Core/Src/main.c ****     "  name <can id> <name> [<index>]: name a device\r\n"
 400:Core/Src/main.c ****     "  name clear <can id>: clear names\r\n"
 401:Core/Src/main.c ****     "  name list <can id>: list names\r\n"
 402:Core/Src/main.c ****     "bus - CAN bus operations\r\n"
 403:Core/Src/main.c ****     "  bus reset: reset whole CAN bus\r\n"
 404:Core/Src/main.c ****     "  bus list: list all devices on bus\r\n"
 405:Core/Src/main.c ****     "sd - SD card setup\r\n"
 406:Core/Src/main.c ****     "  sd init: initialize microSD\r\n"
ARM GAS  /tmp/cc9FdxZ4.s 			page 45


 407:Core/Src/main.c ****     "  sd free: print microSD free space\r\n"
 408:Core/Src/main.c ****     "  sd deinit: deinitalize microSD\r\n"
 409:Core/Src/main.c ****     "file - file operations\r\n"
 410:Core/Src/main.c ****     "  file run <file>: runs a file as commands\r\n"
 411:Core/Src/main.c ****     "  file program <file>: programs a file. Typed commands are written to the end of the file\r\n"
 412:Core/Src/main.c ****     "  file endp: stop programming and write commands to file\r\n"
 413:Core/Src/main.c ****     "  file read <file>: reads all lines in a file\r\n"
 414:Core/Src/main.c ****     "  file delete <file>: deletes a file\r\n"
 415:Core/Src/main.c ****     "  file delline <file> <line>: deletes a single line of a file\r\n"
 416:Core/Src/main.c ****     "  file list: lists files in root directory\r\n"
 417:Core/Src/main.c ****     "relay - control relays\r\n"
 418:Core/Src/main.c ****     "  relay off <device>: turns off a relay, supports entire boards\r\n"
 419:Core/Src/main.c ****     "  relay on <device>: turns on a relay\r\n"
 420:Core/Src/main.c ****     "  relay reset <device>: reset relay boards\r\n"
 421:Core/Src/main.c ****     "servo - control servos\r\n"
 422:Core/Src/main.c ****     "  servo off <device>: disengage servo\r\n"
 423:Core/Src/main.c ****     "  servo on <device>: engage servo\r\n"
 424:Core/Src/main.c ****     "  servo set <device> <angle>: set servo to angle\r\n"
 425:Core/Src/main.c ****     "  servo reset <device>: reset servo boards\r\n"
 426:Core/Src/main.c ****     "tc - control thermocouples\r\n"
 427:Core/Src/main.c ****     "  tc get <device>: reads TC temperature\r\n"
 428:Core/Src/main.c ****     "  tc status <device>: reads TC status flags\r\n"
 429:Core/Src/main.c ****     "  tc reset <device>: resets TC boards\r\n"
 430:Core/Src/main.c ****     "pt - control pressure transducers\r\n"
 431:Core/Src/main.c ****     "  pt get <device>: reads PT pressure\r\n"
 432:Core/Src/main.c ****     "  pt reset <device>: resets PT boards\r\n"
 433:Core/Src/main.c ****     "time - timer functions\r\n"
 434:Core/Src/main.c ****     "  time stamp: get current timestamp\r\n"
 435:Core/Src/main.c ****     "  time mark: set mark, time stamp shows time since mark\r\n"
 436:Core/Src/main.c ****     "  time sleep <ms>: sleep for a time in ms\r\n"
 437:Core/Src/main.c ****     "  time delay <ms> <command...>: run the command after a time in ms\r\n"
 438:Core/Src/main.c ****     "  time every <ms> <command...>: run the command every interval in ms\r\n"
 439:Core/Src/main.c ****     "  time list: list timers running\r\n"
 440:Core/Src/main.c ****     "  time delete [<id>]: delete that timer, default is last added\r\n"
 441:Core/Src/main.c ****     "  time quiet [<id>]: silence/unsilence messages from that timer\r\n"
 442:Core/Src/main.c ****     "msg - message functions\r\n"
 443:Core/Src/main.c ****     "  msg echo <message...>: prints the message out\r\n"
 444:Core/Src/main.c ****     "log - data logging functions\r\n"
 445:Core/Src/main.c ****     "  log open <file>: opens file for data logging, append to end\r\n"
 446:Core/Src/main.c ****     "  log close: close open log file\r\n"
 447:Core/Src/main.c ****     "  log sync: write new changes back to log file\r\n"
 448:Core/Src/main.c ****     "  log line <format...>: write a line of data to the log file; specifiers separated by spaces:\
 449:Core/Src/main.c ****     "   t -> time stamp in ms\r\n"
 450:Core/Src/main.c ****     "   m -> time since mark in ms\r\n"
 451:Core/Src/main.c ****     "   '<TEXT> -> that text\r\n"
 452:Core/Src/main.c ****     "   P<PT name> -> pressure in psi\r\n"
 453:Core/Src/main.c ****     "On startup or reset, startup.scr is run automatically.\r\n"
 454:Core/Src/main.c ****   );
