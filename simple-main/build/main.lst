 724:Core/Src/main.c ****       if (name_maps[i].can_id == id) {
 725:Core/Src/main.c ****         yes = 1;
 726:Core/Src/main.c ****         if (!terse) {
 727:Core/Src/main.c ****           UART2_Print("Names for device ");
 728:Core/Src/main.c ****           UART2_Print_Int(id);
