 813:Core/Src/main.c ****       CAN_Send(0x02);
 814:Core/Src/main.c ****     } else if (last_index == 2) {
 815:Core/Src/main.c ****       if (!terse) UART2_Print("Turning relay OFF.\r\n");
 816:Core/Src/main.c ****       CAN_Send(0x04);
 817:Core/Src/main.c ****     } else if (last_index == 3) {
 818:Core/Src/main.c ****       if (!terse) UART2_Print("Turning relay OFF.\r\n");
 819:Core/Src/main.c ****       CAN_Send(0x06);
 820:Core/Src/main.c ****     } else {
 821:Core/Src/main.c ****       if (!terse) UART2_Print("Turning relays OFF.\r\n");
 822:Core/Src/main.c ****       CAN_Send(0x02);
 823:Core/Src/main.c ****       CAN_Send(0x04);
 824:Core/Src/main.c ****       CAN_Send(0x06);
