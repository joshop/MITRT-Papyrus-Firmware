 767:Core/Src/main.c ****     } else {
 768:Core/Src/main.c ****       UART2_Print(terse ? "OK\r\n" : "Name registered.\r\n");
 769:Core/Src/main.c ****     }
 770:Core/Src/main.c ****   }
 771:Core/Src/main.c **** }
