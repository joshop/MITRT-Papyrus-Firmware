 540:Core/Src/main.c **** int retrieve_id(char *label) {
 541:Core/Src/main.c ****   last_index = -1;
 542:Core/Src/main.c ****   for (int i = 0; i < num_maps; i++) {
 543:Core/Src/main.c ****     for (int j = 0; j < name_maps[i].num_names; j++) {
 544:Core/Src/main.c ****       if (!strcmp(name_maps[i].names[j].name, label)) {
 545:Core/Src/main.c ****         last_index = name_maps[i].names[j].index;
 546:Core/Src/main.c ****         return name_maps[i].can_id;
 547:Core/Src/main.c ****       }
 548:Core/Src/main.c ****     }
 549:Core/Src/main.c ****   }
