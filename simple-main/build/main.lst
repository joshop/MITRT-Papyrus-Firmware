 107:Core/Src/main.c **** HAL_StatusTypeDef Flash_SaveArray(uint32_t pageAddress, uint8_t *data, uint32_t length)
 108:Core/Src/main.c **** {
 109:Core/Src/main.c ****   HAL_StatusTypeDef status;
 110:Core/Src/main.c ****   uint32_t pageError = 0;
 111:Core/Src/main.c **** 
 112:Core/Src/main.c ****   FLASH_EraseInitTypeDef eraseInit;
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****   if(length > FLASH_PAGE_SIZE)
