 950:Core/Src/main.c ****       prefix = "MiB";
 951:Core/Src/main.c ****       size >>= 20;
 952:Core/Src/main.c ****     } else if (size > 10*1024) {
 953:Core/Src/main.c ****       prefix = "KiB";
 954:Core/Src/main.c ****       size >>= 10;
 955:Core/Src/main.c ****     } else {
 956:Core/Src/main.c ****       prefix = "B";
 957:Core/Src/main.c ****     }
 958:Core/Src/main.c ****     sprintf(buffer, "%-18s %lu %s\r\n", filinfo.fname, size, prefix);
 959:Core/Src/main.c ****     UART2_Print(buffer);
 960:Core/Src/main.c ****   }
 961:Core/Src/main.c ****   f_closedir(&dir);
 962:Core/Src/main.c **** }
