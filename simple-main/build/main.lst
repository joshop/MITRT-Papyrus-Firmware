 924:Core/Src/main.c ****     servo = &def;
 925:Core/Src/main.c ****   }
 926:Core/Src/main.c ****   if (!servo->initialized) {
 927:Core/Src/main.c ****     servo->initialized = 1;
 928:Core/Src/main.c ****     servo->min_us = 500;
 929:Core/Src/main.c ****     servo->max_us = 2500;
 930:Core/Src/main.c ****     servo->min_angle = 0;
 931:Core/Src/main.c ****     servo->max_angle = 180;
 932:Core/Src/main.c ****   }
