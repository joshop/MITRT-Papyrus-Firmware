 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****   HAL_FLASH_Unlock();
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****   eraseInit.TypeErase = FLASH_TYPEERASE_PAGES;
 120:Core/Src/main.c ****   eraseInit.Page = (pageAddress - FLASH_BASE) / FLASH_PAGE_SIZE;
 121:Core/Src/main.c ****   eraseInit.NbPages = 1;
 122:Core/Src/main.c **** 
 123:Core/Src/main.c ****   status = HAL_FLASHEx_Erase(&eraseInit, &pageError);
 124:Core/Src/main.c ****   if(status != HAL_OK)
 125:Core/Src/main.c ****   {
 126:Core/Src/main.c ****     HAL_FLASH_Lock();
 127:Core/Src/main.c ****     return status;
 128:Core/Src/main.c ****   }
 129:Core/Src/main.c **** 
